# LLM backend (all optional; without any LLM FinLens runs fully offline with rule-based components).
#
# Default: free local model through Ollama. Start it with `ollama serve` and pull a model once:
#   ollama pull llama3.2:3b
# FINLENS_LLM_PROVIDER=ollama
# FINLENS_LLM_MODEL=llama3.2:3b
#
# The Anthropic API is not used, even if these are set.
#
# Rule-based only, no LLM calls at all:
# FINLENS_LLM_PROVIDER=none
#
# Any setting in finlens/config.py can be overridden, e.g.:
# FINLENS_USE_HYDE=1
# FINLENS_CHUNK_STRATEGY=semantic
# FINLENS_EMBEDDER=st
# FINLENS_RERANKER=ce
